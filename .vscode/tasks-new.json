{
  "version": "3.0.0",
  "tasks": [
    // ==========================================
    // SYSTEM: AUTO TERMINATE PREVIOUS PROCESSES
    // ==========================================
    {
      "label": "Cleanup Ports",
      "type": "shell",
      "command": "taskkill /F /IM node.exe /IM bun.exe 2>nul || exit 0",
      "windows": {
        "command": "taskkill /F /IM node.exe /IM bun.exe 2>nul & exit 0"
      },
      "presentation": { "reveal": "never", "panel": "shared" }
    },

    // ==========================================
    // 1. DEVELOPMENT MODE
    // ==========================================
    {
      "label": "Dev Backend",
      "type": "shell",
      "command": "bun run dev:bun",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": {
        "group": "komify-dev",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Dev Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": {
        "group": "komify-dev",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🚀 1. Mode: Development",
      "dependsOn": ["Cleanup Ports", "Dev Backend", "Dev Frontend"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true }
    },

    // ==========================================
    // 2. PRODUCTION MODE (Build + Start)
    // ==========================================
    {
      "label": "Build Backend",
      "type": "shell",
      "command": "bun run build",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "reveal": "always", "close": true }
    },
    {
      "label": "Build Frontend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "reveal": "always", "close": true }
    },
    {
      "label": "Prod Backend",
      "type": "shell",
      "command": "bun run start:bun",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": {
        "group": "komify-prod",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Prod Frontend",
      "type": "shell",
      "command": "npm run start",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": {
        "group": "komify-prod",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🔥 2. Mode: Production",
      "dependsOn": [
        "Cleanup Ports",
        "Build Backend",
        "Build Frontend",
        "Prod Backend",
        "Prod Frontend"
      ],
      "dependsOrder": "sequence",
      "group": "build"
    }
  ]
}
