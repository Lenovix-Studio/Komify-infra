{
  "version": "2.0.0",
  "tasks": [
    // ==========================================
    // 1. DEVELOPMENT TASKS (Split Terminal Aktif)
    // ==========================================
    {
      "label": "Dev Backend",
      "type": "shell",
      "command": "bun run dev:bun",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": {
        "group": "komify-dev",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Dev Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": {
        "group": "komify-dev",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🚀 1. Mode: Development",
      "dependsOn": ["Dev Backend", "Dev Frontend"],
      "group": { "kind": "build", "isDefault": true }
    },

    // ==========================================
    // 2. BUILD & RESTART TASKS (Alur Otomatis)
    // ==========================================
    {
      "label": "Build Backend",
      "type": "shell",
      "command": "bun run build",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "group": "komify-build", "reveal": "always", "close": true }
    },
    {
      "label": "Build Frontend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "group": "komify-build", "reveal": "always", "close": true }
    },
     {
      "label": "Restart Prod Backend",
      "type": "shell",
      "command": "pm2 delete komify-backend 2>nul & pm2 start bun --name \"komify-backend\" -- run start:bun",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "group": "komify-build", "reveal": "silent", "close": true }
    },
    {
      "label": "Restart Prod Frontend",
      "type": "shell",
      "command": "pm2 delete komify-frontend 2>nul & pm2 start node_modules/next/dist/bin/next --name \"komify-frontend\" -- start",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "group": "komify-build", "reveal": "silent", "close": true }
    },
    {
      "label": "📦 2. Build & Restart Production",
      "dependsOn": [
        "Build Backend",
        "Build Frontend",
        "Restart Prod Backend",
        "Restart Prod Frontend"
      ],
      "dependsOrder": "sequence",
      "group": "build"
    },

    // ==========================================
    // 3. MANUAL PRODUCTION VIEW (Cek Status PM2)
    // ==========================================
    {
      "label": "🔥 3. Mode: Production Status",
      "type": "shell",
      "command": "pm2 ls",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
